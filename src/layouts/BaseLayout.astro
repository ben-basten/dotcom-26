---
import Footer from "~/components/navigation/Footer.astro";
import MainNavigation from "~/components/navigation/MainNavigation.astro";
import { Font } from "astro:assets";
import "~/styles/main.css";
import { COLOR_CLASS, type ThemeColor } from "~/utils/colors.constants";

interface Props {
  color?: ThemeColor;
}

const { color = "pink" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-asap" />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Basten Blog"
      href="/feed.xml"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <slot name="seo" />
  </head>
  <body class={COLOR_CLASS[color]}>
    <div class="flex min-h-dvh flex-col">
      <MainNavigation />
      <main tabindex="-1" class="flex-1 outline-none isolate">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
