---
import Footer from "~/components/navigation/Footer.astro";
import MainNavigation from "~/components/navigation/MainNavigation.astro";
import SkipLink from "~/components/navigation/SkipLink.astro";
import { Font } from "astro:assets";
import "~/styles/main.css";
import { COLOR_CLASS, type ThemeColor } from "~/utils/colors.constants";
import { MAIN_ID } from "~/utils/copy.constants";

interface Props {
  color?: ThemeColor;
}

const { color = "pink" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Font
      cssVariable="--font-asap"
      preload={[
        { weight: 400, style: "normal" },
        { weight: 500, style: "normal" },
        { weight: 800, style: "normal" },
      ]}
    />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Basten Blog"
      href="/feed.xml"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <slot name="seo" />
  </head>
  <body class={COLOR_CLASS[color]}>
    <div
      class="relative z-10 flex min-h-dvh flex-col shadow-[0_4px_12px_rgb(19_21_19/8%)]"
    >
      <SkipLink />
      <MainNavigation />
      <main
        id={MAIN_ID}
        tabindex="-1"
        class="pb-15 flex-1 bg-background outline-none isolate md:pb-30"
      >
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
