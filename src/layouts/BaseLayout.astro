---
import Footer from "~/components/navigation/Footer.astro";
import MainNavigation from "~/components/navigation/MainNavigation.astro";
import SkipLink from "~/components/navigation/SkipLink.astro";
import { Font } from "astro:assets";
import iconsBackground from "~/images/icons.svg?url";
import "~/styles/main.css";
import { COLOR_CLASS, type ThemeColor } from "~/utils/colors.constants";
import { MAIN_ID } from "~/utils/copy.constants";

interface Props {
  color?: ThemeColor;
  preloadHeroIcons?: boolean;
}

const { color = "pink", preloadHeroIcons = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-asap" />
    <meta charset="utf-8" />
    {
      preloadHeroIcons && (
        <link
          rel="preload"
          as="image"
          href={iconsBackground}
          type="image/svg+xml"
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Basten Blog"
      href="/feed.xml"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <slot name="seo" />
  </head>
  <body class={COLOR_CLASS[color]}>
    <div
      class="relative z-10 flex min-h-dvh flex-col shadow-[0_4px_12px_rgb(19_21_19/8%)]"
    >
      <SkipLink />
      <MainNavigation />
      <main
        id={MAIN_ID}
        tabindex="-1"
        class="pb-15 flex-1 bg-background outline-none isolate md:pb-30"
      >
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
