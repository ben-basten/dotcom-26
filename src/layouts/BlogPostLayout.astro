---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Hero from "~/components/common/Hero.astro";
import Heading from "~/components/base/Heading.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  color="mango"
>
  <Hero />
  <ContentContainer>
    <article class="py-12 space-y-6">
      <header class="space-y-2">
        <Heading as="h1">{post.data.title}</Heading>
        <p class="type-body text-sm text-black/70">
          <time datetime={post.data.date.toISOString()}>
            {
              post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
        </p>
        {
          post.data.tags.length > 0 && (
            <p class="type-body text-sm text-black/70">
              {post.data.tags.join(", ")}
            </p>
          )
        }
      </header>
      <div class="space-y-4">
        <slot />
      </div>
    </article>
  </ContentContainer>
</BaseLayout>
