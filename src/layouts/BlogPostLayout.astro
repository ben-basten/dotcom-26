---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Hero from "~/components/common/Hero.astro";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---

<BaseLayout color="mango">
  <slot name="seo" slot="seo" />
  <Hero
    heading={post.data.title}
    excerpt={post.data.excerpt}
    subtext={post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })}
  />
  <ContentContainer>
    <article class="mx-auto max-w-[41.25rem] space-y-6 py-12">
      <div class="space-y-4">
        <slot />
      </div>
    </article>
  </ContentContainer>
</BaseLayout>
