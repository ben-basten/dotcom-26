---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";

interface Props {
  work: CollectionEntry<"work">;
}

const { work } = Astro.props as Props;
---

<BaseLayout
  title={work.data.title}
  description={work.data.summary}
  color="pink"
>
  <ContentContainer>
    <article class="pt-nav-height pb-12 space-y-6">
      <header class="space-y-2">
        <Heading as="h1">{work.data.title}</Heading>
        {work.data.role && <p class="type-body">{work.data.role}</p>}
        <p class="type-body">{work.data.summary}</p>
        {
          work.data.stack.length > 0 && (
            <p class="type-body text-sm text-black/70">
              {work.data.stack.join(", ")}
            </p>
          )
        }
      </header>
      <div class="space-y-4">
        <slot />
      </div>
    </article>
  </ContentContainer>
</BaseLayout>
