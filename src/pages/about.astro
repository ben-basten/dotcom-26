---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MediaHero from "~/components/common/MediaHero.astro";
import SEO from "~/components/base/SEO.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import FiftyFifty from "~/components/about/FiftyFifty.astro";
import Contact from "~/components/about/Contact.astro";
import { TAGLINE } from "~/utils/copy.constants";

const pageTitle = "About me";
---

<BaseLayout color="periwinkle" preloadHeroIcons>
  <SEO slot="seo" title={pageTitle} description={TAGLINE} />
  <MediaHero title={pageTitle} />
  <ContentContainer class="mt-section-space">
    <FiftyFifty class="max-w-250 mx-auto" />
    <Contact />
  </ContentContainer>
</BaseLayout>
