---
import { getCollection } from "astro:content";
import ContentContainer from "~/components/base/ContentContainer.astro";
import MediaHero from "~/components/common/MediaHero.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SEO from "~/components/common/SEO.astro";
import { compareByDateDesc } from "~/utils/date.helpers";

const posts = (await getCollection("posts")).sort(compareByDateDesc);
---

<BaseLayout color="mango">
  <SEO slot="seo" title="Blog" />
  <MediaHero title="Blog" />
  <ContentContainer as="section">
    <div class="pt-nav-height pb-12 space-y-4">
      {
        posts.length === 0 ? (
          <p class="type-body">No posts yet.</p>
        ) : (
          <ul class="space-y-2">
            {posts.map((post) => (
              <li>
                <a href={`/posts/${post.id}/`} class="underline">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </ContentContainer>
</BaseLayout>
