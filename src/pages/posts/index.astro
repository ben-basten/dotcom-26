---
import { getCollection } from "astro:content";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";
import MediaHero from "~/components/common/MediaHero.astro";
import BlogPostList from "~/components/posts/BlogPostList.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SEO from "~/components/common/SEO.astro";
import { compareByDateDesc } from "~/utils/date.helpers";

const posts = (await getCollection("posts")).sort(compareByDateDesc);
const postsByYear = posts.reduce((groups, post) => {
  const year = post.data.date.getUTCFullYear();
  const yearPosts = groups.get(year) ?? [];
  yearPosts.push(post);
  groups.set(year, yearPosts);
  return groups;
}, new Map<number, typeof posts>());
---

<BaseLayout color="mango">
  <SEO
    slot="seo"
    title="Blog"
    description="My writing on topics ranging from self hosting, privacy, random dev learnings, and everything in between."
  />
  <MediaHero title="Blog">
    <Fragment slot="excerpt">
      Here you'll find my writing on topics from self hosting, privacy, random
      dev learnings, and everything in between. Subscribe to the
      <a href="/feed.xml" class="text-white hover:text-theme">RSS feed</a> to make
      sure you don't miss new posts!
    </Fragment>
  </MediaHero>
  <ContentContainer as="section" class="pt-section-space">
    <div class="mx-auto max-w-200 flex flex-col gap-y-10">
      {
        Array.from(postsByYear, ([year, yearPosts]) => (
          <section class="space-y-4">
            <Heading as="h2" variant="h3">
              {year}
            </Heading>
            <BlogPostList posts={yearPosts} />
          </section>
        ))
      }
    </div>
  </ContentContainer>
</BaseLayout>
