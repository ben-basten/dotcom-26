---
import { getCollection } from "astro:content";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";
import Hero from "~/components/common/Hero.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SEO from "~/components/common/SEO.astro";

const posts = await getCollection("posts");
---

<BaseLayout color="mango">
  <SEO slot="seo" title="Blog" />
  <Hero heading="Blog" />
  <ContentContainer as="section">
    <div class="pt-nav-height pb-12 space-y-4">
      <Heading as="h1">Posts</Heading>
      {
        posts.length === 0 ? (
          <p class="type-body">No posts yet.</p>
        ) : (
          <ul class="space-y-2">
            {posts.map((post) => (
              <li>
                <a href={`/posts/${post.id}/`} class="underline">
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </ContentContainer>
</BaseLayout>
