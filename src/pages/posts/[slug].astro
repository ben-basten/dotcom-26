---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import PostHero from "~/components/common/PostHero.astro";
import SEO from "~/components/common/SEO.astro";
import { formatDate } from "~/utils/date.helpers";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout color="mango">
  <SEO slot="seo" title={post.data.title} description={post.data.excerpt} />
  <article>
    <PostHero
      title={post.data.title}
      excerpt={post.data.excerpt}
      subtext={formatDate(post.data.date)}
    />
    <ContentContainer class="relative z-2">
      <div class="markdown-content">
        <Content />
      </div>
    </ContentContainer>
  </article>
</BaseLayout>
