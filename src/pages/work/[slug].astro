---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import PostHero from "~/components/common/PostHero.astro";
import SEO from "~/components/base/SEO.astro";
import Technologies from "~/components/work/Technologies.astro";
import Link from "~/components/base/Link.astro";

export async function getStaticPaths() {
  const workEntries = await getCollection("work");

  return workEntries.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const ogImage = work.data.hero
  ? await getImage({
      src: work.data.hero.image,
      width: 1200,
      height: 630,
      fit: "cover",
      format: "jpeg",
      quality: "low",
    })
  : undefined;
---

<BaseLayout color={work.data.theme ?? "pink"}>
  <SEO
    slot="seo"
    title={work.data.title}
    description={work.data.excerpt}
    ogImage={ogImage && new URL(ogImage.src, Astro.site ?? Astro.url).href}
  />
  <article>
    <PostHero
      title={work.data.title}
      excerpt={work.data.excerpt}
      subtext={work.data.role}
      image={work.data.hero?.image}
      imageAlt={work.data.hero?.alt}
    />
    <ContentContainer class="relative z-2">
      {work.data.stack.length > 0 && <Technologies stack={work.data.stack} />}
      <div class="markdown-content mt-section-space">
        <Content />
        {
          work.data.demo && (
            <div class="mt-6 text-lg">
              <Link href={work.data.demo.url} newTab>
                Visit site
              </Link>
            </div>
          )
        }
      </div>
    </ContentContainer>
  </article>
</BaseLayout>
