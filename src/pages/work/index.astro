---
import { getCollection } from "astro:content";
import ContentContainer from "~/components/base/ContentContainer.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import MediaHero from "~/components/common/MediaHero.astro";
import SEO from "~/components/common/SEO.astro";
import WorkGrid from "~/components/work/WorkGrid.astro";
import { compareByDateDesc } from "~/utils/date.helpers";

const workEntries = (await getCollection("work")).sort(compareByDateDesc);
const excerpt = "Recent projects and tinkering that I'm excited about.";
---

<BaseLayout color="pink">
  <SEO slot="seo" title="Work" description={excerpt} />
  <MediaHero title="My work" {excerpt} />
  <ContentContainer as="section" class="mt-section-space">
    <WorkGrid entries={workEntries} />
  </ContentContainer>
</BaseLayout>
