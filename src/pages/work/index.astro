---
import { getCollection } from "astro:content";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import MediaHero from "~/components/common/MediaHero.astro";
import SEO from "~/components/common/SEO.astro";

const workEntries = await getCollection("work");
---

<BaseLayout color="pink">
  <SEO slot="seo" title="Work" />
  <MediaHero title="My work" />
  <ContentContainer as="section">
    <div class="pt-nav-height pb-12 space-y-4">
      <Heading as="h1">Work</Heading>
      {
        workEntries.length === 0 ? (
          <p class="type-body">No work entries yet.</p>
        ) : (
          <ul class="space-y-2">
            {workEntries.map((work) => (
              <li>
                <a href={`/work/${work.id}/`} class="underline">
                  {work.data.title}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </ContentContainer>
</BaseLayout>
