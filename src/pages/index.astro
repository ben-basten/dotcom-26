---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";
import ArrowLink from "~/components/base/ArrowLink.astro";
import MediaHero from "~/components/common/MediaHero.astro";
import SEO from "~/components/base/SEO.astro";
import BlogPostList from "~/components/posts/BlogPostList.astro";
import WorkGrid from "~/components/work/WorkGrid.astro";
import { TAGLINE } from "~/utils/copy.constants";
import { compareByDateDesc } from "~/utils/date.helpers";

const featuredWork = (await getCollection("work"))
  .sort(compareByDateDesc)
  .slice(0, 2);
const recentPosts = (await getCollection("posts"))
  .sort(compareByDateDesc)
  .slice(0, 3);
---

<BaseLayout color="green">
  <SEO slot="seo" title="Ben Basten" description={TAGLINE} />
  <MediaHero title="Ben Basten" excerpt={TAGLINE} />
  <ContentContainer
    as="section"
    class="mt-14 flex flex-col items-center gap-section-space"
  >
    <section class="max-w-200 w-full">
      <Heading as="h2" class="mb-8">Recent posts</Heading>
      <BlogPostList posts={recentPosts} />
      <ArrowLink href="/posts" class="mt-7.5">View all posts</ArrowLink>
    </section>
    <section class="max-w-200">
      <Heading as="h2" class="mb-8">Featured work</Heading>
      <WorkGrid entries={featuredWork} headingLevel="h3" />
      <ArrowLink href="/work" class="mt-7.5 mx-auto">View all work</ArrowLink>
    </section>
  </ContentContainer>
</BaseLayout>
