---
import type { HTMLAttributes } from "astro/types";

type Size = "md" | "lg";

interface Props extends Omit<HTMLAttributes<"a">, "size"> {
  href: string;
  size?: Size;
}

const { size = "md", class: className, ...attrs } = Astro.props;

const sizeClasses: Record<Size, string> = {
  md: "text-xl px-5 py-2",
  lg: "text-2xl px-7 py-3",
};
---

<a
  {...attrs}
  class:list={[
    "group no-underline inline-flex self-center rounded-lg text-white font-semibold shadow-[0.25rem_0.25rem_0_var(--color-foreground)] outline-offset-6",
    className,
  ]}
>
  <span
    class:list={[
      "flex items-center rounded-lg bg-primary motion-safe:transition-transform group-hover:translate-x-1 group-hover:translate-y-1 ease-out",
      sizeClasses[size],
    ]}
  >
    <slot />
  </span>
</a>
