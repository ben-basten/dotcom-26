---
import { Image } from "astro:assets";
import Heading from "~/components/base/Heading.astro";
import silhouette from "~/images/about/silhouette.webp";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={["grid items-center gap-8 md:grid-cols-2 md:gap-12", className]}
>
  <div>
    <Heading as="h2" class="mb-4">Who I am</Heading>
    <p>
      I am a full stack web developer that's passionate about building
      accessible, scalable websites and products. With experience working in the
      healthcare industry with HealthPartners, contributing to open source
      Immich development, and partnering with entertainment companies like
      Audible, I have experience delivering quality products for end users that
      feel awesome to use.
    </p>
  </div>
  <Image
    src={silhouette}
    alt="Ben silhouetted on a snowy lake at dusk"
    class="aspect-4/3 w-full rounded-xl object-cover"
    widths={[400, 640, 800, 1200]}
    sizes="(min-width: 64rem) 30rem, (min-width: 48rem) 50vw, 100vw"
  />
</div>
