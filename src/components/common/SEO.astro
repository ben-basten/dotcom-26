---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  robots?: string;
}

const { title, description, ogImage, robots } = Astro.props;
const pageTitle = title === "Ben Basten" ? title : `${title} | Ben Basten`;
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "") || "index";
const image =
  ogImage ?? new URL(`/og/${slug}.png`, Astro.site ?? Astro.url).href;
---

<title>{pageTitle}</title>
{robots && <meta name="robots" content={robots} />}
<meta property="og:title" content={pageTitle} />
{description && <meta name="description" content={description} />}
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
