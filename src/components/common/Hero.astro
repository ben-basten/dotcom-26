---
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";

interface Props {
  heading: string;
  excerpt?: string;
  subtext?: string;
}

const { heading, excerpt, subtext } = Astro.props;
---

<ContentContainer width="wide" class="pt-inset">
  <section
    class="bg-theme relative h-250 max-h-[75dvh] w-full overflow-hidden rounded-xl"
  >
    <header
      class="absolute inset-x-0 bottom-0 w-full bg-theme-dark p-6 text-background [&_h1]:text-background md:top-2/3 md:bottom-auto md:w-3/5 md:rounded-tr-lg md:rounded-br-lg lg:w-2/5"
    >
      <Heading as="h1">{heading}</Heading>
      {excerpt && <p class="type-body mt-2">{excerpt}</p>}
      {
        subtext && (
          <p class="type-body mt-2 text-sm text-background/80">{subtext}</p>
        )
      }
    </header>
  </section>
</ContentContainer>
