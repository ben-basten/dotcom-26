---
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";

interface Props {
  title: string;
  excerpt?: string;
}

const { title: heading, excerpt } = Astro.props;
---

<ContentContainer width="wide" class="pt-inset">
  <section
    class="bg-theme relative h-250 max-h-[75dvh] w-full overflow-hidden rounded-xl"
  >
    <div
      class="absolute inset-x-0 bottom-0 w-full bg-theme-dark py-6 ps-side-mobile md:ps-side pe-side-mobile md:pe-6 text-background md:top-2/3 md:-translate-y-1/2 md:bottom-auto md:w-3/5 md:rounded-tr-lg md:rounded-br-lg lg:w-2/5"
    >
      <Heading as="h1">{heading}</Heading>
      {excerpt && <p class="type-body mt-2">{excerpt}</p>}
    </div>
  </section>
</ContentContainer>
