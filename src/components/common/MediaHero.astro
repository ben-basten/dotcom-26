---
import ContentContainer from "~/components/base/ContentContainer.astro";
import Heading from "~/components/base/Heading.astro";
import IconGrid from "~/components/common/IconGrid.astro";

interface Props {
  title: string;
  excerpt?: string;
}

const { title: heading, excerpt } = Astro.props;
---

<ContentContainer width="wide" class="pt-inset">
  <section
    class="bg-theme relative h-180 max-h-[min(90dvh,580px)] md:max-h-[min(90dvh,720px)] w-full overflow-hidden rounded-xl"
  >
    <div
      class="absolute z-1 inset-x-0 bottom-0 flex flex-col gap-3 w-full bg-theme-dark py-6 ps-[calc(var(--spacing-side-mobile)-var(--spacing-inset))] md:ps-[calc(var(--spacing-side)-var(--spacing-inset))] min-[95rem]:ps-side pe-side-mobile md:pe-6 text-background md:top-2/3 md:-translate-y-1/2 md:bottom-auto md:w-3/5 md:rounded-tr-lg md:rounded-br-lg lg:w-2/5"
    >
      <Heading as="h1">{heading}</Heading>
      {
        Astro.slots.has("excerpt") ? (
          <p>
            <slot name="excerpt" />
          </p>
        ) : (
          excerpt && <p>{excerpt}</p>
        )
      }
    </div>
    <IconGrid />
  </section>
</ContentContainer>
