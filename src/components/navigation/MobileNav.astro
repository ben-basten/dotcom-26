---
import Button from "~/components/base/Button.astro";
import type { NavLink } from "~/types/NavLink";
import { normalizePathname } from "~/utils/url.helpers";

interface Props {
  links: NavLink[];
  ctaLink: NavLink;
}

const { links, ctaLink } = Astro.props;
const currentPath = normalizePathname(Astro.url.pathname);
---

<details class="pointer-events-none md:hidden">
  <summary
    aria-label="Toggle menu"
    class="pointer-events-auto relative z-20 flex size-11 cursor-pointer list-none flex-col items-center justify-center gap-1.5 rounded-lg border-3 border-theme-dark bg-background [&::-webkit-details-marker]:hidden"
  >
    <span class="h-0.5 w-5 bg-foreground"></span>
    <span class="h-0.5 w-5 bg-foreground"></span>
    <span class="h-0.5 w-5 bg-foreground"></span>
  </summary>
  <div
    class="pointer-events-auto fixed inset-0 z-10 flex flex-col items-center justify-center gap-8 bg-background px-6"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class="text-4xl font-bold text-foreground hover:text-primary aria-[current=page]:text-primary"
        >
          {link.text}
        </a>
      ))
    }
    <Button
      href={ctaLink.href}
      size="lg"
      aria-current={currentPath === ctaLink.href ? "page" : undefined}
    >
      {ctaLink.text}
    </Button>
  </div>
</details>
