---
import Button from "~/components/base/Button.vue";
import type { NavLink } from "~/types/NavLink";
import { normalizePathname } from "~/utils/url.helpers";

interface Props {
  links: NavLink[];
  ctaLink: NavLink;
}

const { links, ctaLink } = Astro.props;
const currentPath = normalizePathname(Astro.url.pathname);
---

<div class="pointer-events-auto hidden self-stretch gap-7.5 md:flex">
  <div class="flex h-full items-center gap-3.5">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPath === link.href ? "page" : undefined}
          class:list={[
            "relative text-xl no-underline font-semibold hover:z-5 hover:nav-active active:nav-active hover:bg-theme-light transition-[rotate,scale,background-color] duration-default ease-snap",
            "bg-background px-5 py-2 rounded-lg border-3 border-theme-dark",
            'aria-[current="page"]:nav-active',
          ]}
        >
          {link.text}
        </a>
      ))
    }
  </div>
  <Button
    href={ctaLink.href}
    size="md"
    aria-current={currentPath === ctaLink.href ? "page" : undefined}
    class="h-full"
  >
    {ctaLink.text}
  </Button>
</div>
