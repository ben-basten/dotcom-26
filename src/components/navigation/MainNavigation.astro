---
import Button from "~/components/base/Button.astro";
import ContentContainer from "~/components/base/ContentContainer.astro";
import Logo from "./Logo.astro";

type Link = {
  text: string;
  href: string;
};

const links: Link[] = [
  { text: "Work", href: "/work" },
  { text: "Blog", href: "/posts" },
];
const ctaLink: Link = { text: "Contact", href: "/contact" };
---

<nav class="fixed top-inset w-full z-1000">
  <ContentContainer class="mt-inset">
    <div class="flex justify-between items-center h-nav-bar">
      <Logo />
      <div class="self-stretch flex gap-7.5">
        <div class="flex h-full items-center gap-3.5">
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={
                  Astro.url.pathname === link.href ? "page" : undefined
                }
                class:list={[
                  "relative text-xl font-semibold hover:z-5 hover:nav-active active:nav-active hover:bg-theme-light transition-[rotate,scale,background-color] duration-default ease-snap",
                  "bg-background px-5 py-2 rounded-lg border-3 border-theme-dark",
                  'aria-[current="page"]:nav-active',
                ]}
              >
                {link.text}
              </a>
            ))
          }
        </div>
        <Button
          href={ctaLink.href}
          size="md"
          aria-current={Astro.url.pathname === ctaLink.href
            ? "page"
            : undefined}
          class="h-full"
        >
          {ctaLink.text}
        </Button>
      </div>
    </div>
  </ContentContainer>
</nav>
