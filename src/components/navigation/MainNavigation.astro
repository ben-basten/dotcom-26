---
import ContentContainer from "~/components/base/ContentContainer.astro";
import Logo from "./Logo.astro";

type Link = {
  text: string;
  href: string;
};

const links: Link[] = [
  { text: "Work", href: "/work" },
  { text: "Blog", href: "/posts" },
];
const ctaLink: Link = { text: "Contact", href: "/contact" };
---

<nav class="fixed top-inset w-full z-1000">
  <ContentContainer class="mt-inset">
    <div class="flex justify-between items-center h-nav-bar">
      <Logo />
      <div class="self-stretch flex gap-5">
        <div
          class="bg-background border-3 border-forest px-7.5 py-1 flex h-full items-center gap-8 rounded-lg"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={
                  Astro.url.pathname === link.href ? "page" : undefined
                }
                class:list={[
                  "text-xl font-semibold hover:nav-active transition-transform duration-default ease-snap",
                  'aria-[current="page"]:border-b-2 border-secondary aria-[current="page"]:nav-active',
                ]}
              >
                {link.text}
              </a>
            ))
          }
        </div>
        <a
          href={ctaLink.href}
          aria-current={Astro.url.pathname === ctaLink.href
            ? "page"
            : undefined}
          class="group rounded-lg text-white text-xl font-semibold shadow-[0.25rem_0.25rem_0_var(--color-foreground)] outline-offset-6"
        >
          <span
            class="flex items-center rounded-lg h-full w-full bg-secondary px-5 py-1 transition-transform group-hover:translate-x-1 group-hover:translate-y-1 ease-out"
          >
            {ctaLink.text}
          </span>
        </a>
      </div>
    </div>
  </ContentContainer>
</nav>
