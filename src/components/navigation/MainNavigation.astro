---
import ContentContainer from "~/components/base/ContentContainer.astro";
import DesktopNav from "./DesktopNav.astro";
import Logo from "./Logo.astro";
import MobileNav from "./MobileNav.vue";
import type { NavLink } from "~/types/NavLink";
import { normalizePathname } from "~/utils/url.helpers";

const links: NavLink[] = [
  { text: "Work", href: "/work/" },
  { text: "Blog", href: "/posts/" },
];
const ctaLink: NavLink = { text: "About", href: "/about/" };

const currentPath = normalizePathname(Astro.url.pathname);
---

<nav class="pointer-events-none fixed top-inset w-full z-1000">
  <ContentContainer class="mt-inset">
    <div class="flex justify-between items-center h-nav-bar">
      <Logo expanded={currentPath !== "/"} />
      <DesktopNav links={links} ctaLink={ctaLink} />
      <MobileNav
        client:load
        links={links}
        ctaLink={ctaLink}
        currentPath={normalizePathname(Astro.url.pathname)}
      />
    </div>
  </ContentContainer>
</nav>
