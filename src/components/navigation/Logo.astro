<a
  href="/"
  data-scroll-logo
  aria-current={Astro.url.pathname === "/" ? "page" : undefined}
  class:list={[
    "pointer-events-auto relative max-md:ms-2 isolate z-30 no-underline font-bold rounded-lg text-3xl xl:text-5xl text-foreground",
    "after:absolute after:z-0 after:bg-background after:-inset-x-2 after:-inset-y-1 after:rounded-lg after:border-3 after:border-theme-dark hover:after:bg-theme-light after:transition-colors after:duration-default after:ease-in focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-foreground",
  ]}
  aria-label="Ben Basten"
  title="Ben Basten"
>
  <span class="relative z-5">
    B
    <span class="logo-rest">en </span>
    B
    <span class="logo-rest">asten</span>
  </span>
</a>

<script>
  const logo = document.querySelector("[data-scroll-logo]");
  const rest = logo?.querySelectorAll(".logo-rest");
  let previousScrollY = Math.max(0, window.scrollY);

  const updateLogo = () => {
    const scrollY = Math.max(0, window.scrollY);
    if (scrollY === 0 || scrollY !== previousScrollY) {
      const collapsed = scrollY > 0 && scrollY > previousScrollY;
      rest?.forEach((span) => span.classList.toggle("hidden", collapsed));
    }
    previousScrollY = scrollY;
  };

  updateLogo();
  window.addEventListener("scroll", updateLogo, { passive: true });
</script>

<style>
  :global(nav[data-mobile-menu-open]) .logo-rest {
    display: inline;
  }
</style>
